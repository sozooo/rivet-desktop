{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rivet",
  "version": "0.1.0",
  "identifier": "app.rivet.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rivet",
        "width": 1440,
        "height": 900,
        "minWidth": 920,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFRUQ3M0JDMjBEMjIxNDgKUldSSUlkSWd2SFB0RG0vNTZrSGFYbk4xWWxOMFZyZmlJSTArWkxZSnpDVklrUDRkNXE4MStHU20K",
      "endpoints": [
        "https://github.com/sozooo/rivet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
